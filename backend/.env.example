DATABASE_URL=postgres://user:password@localhost:5432/heat_relief
PORT=4000

# Shared secret that gates the org-facing admin routes (site management,
# invite issuing, resident priority queue). REQUIRED — those routes refuse to
# serve without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# Notifications (Phase 1+)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# NWS API needs no key, but set a contact email per their usage policy
NWS_USER_AGENT_EMAIL=you@example.org

# Resident email (heat alerts, cooling centers, welcome email with Registration ID)
# Leave SMTP_HOST empty to use a free Ethereal TEST inbox: nothing reaches real
# addresses, and each email's preview link is printed to the server console.
# For real delivery via Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_SECURE=true, SMTP_USER=<the Gmail address>, SMTP_PASS=<a Google app
# password, NOT the account password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HeatSafe Alerts <alerts@heatsafe.test>
# Where links in emails point (the resident-facing site)
FRONTEND_BASE_URL=http://localhost:3000
